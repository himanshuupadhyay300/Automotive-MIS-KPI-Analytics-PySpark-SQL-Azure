# Copy to .env (git-ignored). Local mode needs none of these. NEVER commit real values.
MIS_STORAGE_FORMAT=parquet        # parquet | delta
MIS_BASE_PATH=output/lakehouse
MIS_INPUT_PATH=data/sample
MIS_REPORTS_PATH=output/reports
MIS_LOG_LEVEL=INFO

# Optional Azure (prefer Key Vault / Databricks secret scopes in real deployments)
AZURE_STORAGE_ACCOUNT=<storage-account-name>
# Do not put account keys here. Use managed identity / service principal via Key Vault.
